 salesOwner AppUser? @relation(fields:[salesOwnerId],references:[id])
 salesOwnerId String?
 sourceLeadId String?
 sourceLead Lead? @relation(fields:[sourceLeadId],references:[id])
 salesAgreement ServiceAgreement?
 @@index([salesOwnerId,sourceLeadId])
 issuerSnapshot Json?
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 number String? @unique
 status String @default("DRAFT")
 validUntil String
 currency String @default("CAD")
 items Json
 subtotalCents Int
 taxCents Int
 totalCents Int
 version Int @default(1)
 idempotencyKey String @unique
 payloadHash String
 decisionNote String?
 issuedAt DateTime?
 acceptedAt DateTime?
 conversionDueDate String?
 convertedInvoiceId String? @unique
 convertedInvoice Invoice? @relation("ConvertedQuote", fields: [convertedInvoiceId], references: [id])
 createdAt DateTime @default(now())
 @@index([customerId, status])
}

