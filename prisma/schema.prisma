generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../node_modules/.prisma/client"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum VisitStatus {
 PENDING
 PROPOSED
 CONFIRMED
 SCHEDULED
 IN_PROGRESS
 COMPLETED
 CANCELLED
 RESCHEDULED
 NO_ACCESS
 FAILED
 NEEDS_FOLLOWUP
}
model Customer {
