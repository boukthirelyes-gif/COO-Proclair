generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../node_modules/.prisma/client"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum VisitStatus {
 PENDING
 PROPOSED
 CONFIRMED
 SCHEDULED
 IN_PROGRESS
 COMPLETED
 CANCELLED
 RESCHEDULED
 NO_ACCESS
 FAILED
 NEEDS_FOLLOWUP
}
model Customer {
 legacyId Int? @unique
 legacyCompany String?
 legacyStatus String?
 id String @id @default(cuid())
 name String
 email String?
 phone String?
 notes String @default("")
 version Int @default(1)
 sourceSystem String @default("PROCLAIR")
 rotorExternalId String? @unique
 syncStatus String @default("LOCAL_ONLY")
 lastSyncedAt DateTime?
 lastSyncError String?
 createdAt DateTime @default(now())
 invoices Invoice[]
 properties Property[]
 contracts Contract[]
 jobs Job[]
 visits Visit[]
}
model Property {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 address String
 latitude Float?
 longitude Float?
 createdAt DateTime @default(now())
 contracts Contract[]
 jobs Job[]
 visits Visit[]
}
model Contract {
 id String @id @default(cuid())
 customerId String
 propertyId String
 customer Customer @relation(fields: [customerId], references: [id])
 property Property @relation(fields: [propertyId], references: [id])
 name String
 service String
 totalVisits Int
 priceCents Int
 active Boolean @default(true)
 version Int @default(1)
 createdAt DateTime @default(now())
 invoices Invoice[]
 jobs Job[]
 visits Visit[]
}
model Job {
 id String @id @default(cuid())
 customerId String
 propertyId String
 contractId String
 customer Customer @relation(fields: [customerId], references: [id])
 property Property @relation(fields: [propertyId], references: [id])
 contract Contract @relation(fields: [contractId], references: [id])
 name String
 createdAt DateTime @default(now())
 visits Visit[]
}
model Technician {
 id String @id @default(cuid())
 name String @unique
 active Boolean @default(true)
 dailyTarget Int @default(4)
 fridayTarget Int @default(2)
 visits Visit[]
}
model Visit {
 id String @id @default(cuid())
 customerId String
 propertyId String
 contractId String
 jobId String
 customer Customer @relation(fields: [customerId], references: [id])
 property Property @relation(fields: [propertyId], references: [id])
 contract Contract @relation(fields: [contractId], references: [id])
 job Job @relation(fields: [jobId], references: [id])
 technicianId String?
 technician Technician? @relation(fields: [technicianId], references: [id])
 service String
 status VisitStatus @default(PENDING)
 durationMinutes Int
 actualDurationMinutes Int?
 startsAt DateTime?
 endsAt DateTime?
 priceCents Int
 notes String @default("")
 passageNumber Int
 version Int @default(1)
 sourceSystem String @default("PROCLAIR")
 rotorExternalId String? @unique
 syncStatus String @default("LOCAL_ONLY")
 lastSyncedAt DateTime?
 lastSyncError String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([contractId, passageNumber])
 @@index([technicianId, startsAt])
}
model AuditEvent {
 id String @id @default(cuid())
 actorId String
 actorRole String
 action String
 entityType String
 entityId String
 before Json?
 after Json?
 createdAt DateTime @default(now())
 @@index([entityId, createdAt])
}
model OmegaPlan {
 id String @id @default(cuid())
 date String
 proposals Json
 status String @default("PREVIEW")
 version Int @default(1)
 createdAt DateTime @default(now())
 expiresAt DateTime
 appliedAt DateTime?
 idempotencyKey String? @unique
 result Json?
}

model LegacyTask {
 id String @id @default(cuid())
 legacyId Int @unique
 title String
 due String
 done Boolean
}

model WorkerControl {
 id String @id @default("omega-dispatch")
 enabled Boolean @default(false)
 updatedAt DateTime @updatedAt
}
model WorkerJob {
 id String @id @default(cuid())
 key String @unique
 date String
 status String @default("PENDING")
 attempts Int @default(0)
 maxAttempts Int @default(3)
 availableAt DateTime @default(now())
 planId String?
 lastError String?
 createdAt DateTime @default(now())
 completedAt DateTime?
 @@index([status, availableAt])
}

model Invoice {
 id String @id @default(cuid())
 customerId String
 customer Customer @relation(fields: [customerId], references: [id])
 contractId String?
 contract Contract? @relation(fields: [contractId], references: [id])
 number String? @unique
 status String @default("DRAFT")
 currency String @default("CAD")
 dueDate String
 subtotalCents Int
 taxCents Int
 totalCents Int
 version Int @default(1)
 idempotencyKey String @unique
 payloadHash String
 issuedAt DateTime?
 voidReason String?
 createdAt DateTime @default(now())
 items InvoiceItem[]
 payments Payment[]
}
model InvoiceItem {
 id String @id @default(cuid())
 invoiceId String
 invoice Invoice @relation(fields: [invoiceId], references: [id])
 position Int
 description String
 quantity Int
 unitPriceCents Int
 taxRateBps Decimal @default(0) @db.Decimal(8, 3)
 subtotalCents Int
 taxCents Int
 @@unique([invoiceId, position])
}
model Payment {
 id String @id @default(cuid())
 invoiceId String
 invoice Invoice @relation(fields: [invoiceId], references: [id])
 amountCents Int
 method String
 reference String?
 note String?
 idempotencyKey String @unique
 payloadHash String
 createdAt DateTime @default(now())
 reversal PaymentReversal?
}
model PaymentReversal {
 id String @id @default(cuid())
 paymentId String @unique
 payment Payment @relation(fields: [paymentId], references: [id])
 reason String
 actorId String
 createdAt DateTime @default(now())
}
model InvoiceCounter {
 id String @id
 value Int @default(0)
}

model Expense {
 id String @id @default(cuid())
 vendor String
 category String
 description String
 paidDate String
 amountCents Int
 currency String @default("CAD")
 reference String?
 status String @default("RECORDED")
 voidReason String?
 version Int @default(1)
 idempotencyKey String @unique
 payloadHash String
 createdAt DateTime @default(now())
 @@index([paidDate, status])
}

model IntegrationSecret {
 key String @id
 encryptedValue String @db.Text
 updatedAt DateTime @updatedAt
}
model OAuthReceipt {
 stateHash String @id
 expiresAt DateTime
 @@index([expiresAt])
}
model LoginBucket {
 id String @id
 attempts Int @default(0)
 expiresAt DateTime
 @@index([expiresAt])
}

/**
 * Rotor-owned records, mirrored locally without creating fictitious CRM
 * contracts or overwriting manually managed customers and visits.
 * The compound ID makes re-imports idempotent.
 */
model RotorMirrorRecord {
 kind String
 externalId String
 name String
 status String?
 summary String?
 email String?
 phone String?
 address String?
 customerExternalId String?
 jobExternalId String?
 startsAt DateTime?
 endsAt DateTime?
 syncedAt DateTime @default(now())
 @@id([kind, externalId])
 @@index([kind, syncedAt])
 @@index([kind, startsAt])
}
