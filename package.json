{
  "name": "proclair-os",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "db:generate": "node scripts/generate-client.cjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.cjs",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "legacy:migrate": "bash scripts/migrate-legacy.sh",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test:e2e": "node --env-file=.env tests/browser.mjs",
    "test:finance:e2e": "node --env-file=.env tests/browser-finance.mjs",
    "vercel:build": "node scripts/vercel-build.mjs",
    "test:integrations:e2e": "node --env-file=.env tests/browser-integrations.mjs",
    "check:secrets": "python3 scripts/check-secrets.py",
    "test:quotes:e2e": "node --env-file=.env tests/browser-quotes.mjs",
    "test:portal:e2e": "node --env-file=.env tests/browser-portal.mjs",
    "test:users-map:e2e": "node --env-file=.env tests/browser-users-map.mjs",
    "test:compatibility:e2e": "node --env-file=.env tests/browser-compatibility.mjs",
    "check:parity": "node scripts/render-parity.mjs --check"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "leaflet": "^1.9.4",
    "next": "16.4.0",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@prisma/internals": "^6.19.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "1.58.2",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
