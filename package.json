{
  "name": "proclair-os",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:generate": "node scripts/generate-client.cjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.cjs",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "legacy:migrate": "bash scripts/migrate-legacy.sh",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test:e2e": "node --env-file=.env tests/browser.mjs",
    "test:finance:e2e": "node --env-file=.env tests/browser-finance.mjs",
    "vercel:build": "node scripts/vercel-build.mjs",
    "test:integrations:e2e": "node --env-file=.env tests/browser-integrations.mjs",
    "check:secrets": "python3 scripts/check-secrets.py",
    "test:quotes:e2e": "node --env-file=.env tests/browser-quotes.mjs",
    "test:portal:e2e": "node --env-file=.env tests/browser-portal.mjs",
    "test:users-map:e2e": "node --env-file=.env tests/browser-users-map.mjs",
    "test:compatibility:e2e": "node --env-file=.env tests/browser-compatibility.mjs",
    "check:parity": "node scripts/render-parity.mjs --check",
    "test:leads:e2e": "node --env-file=.env tests/browser-leads.mjs",
    "test:v30:e2e": "node --env-file=.env tests/browser-v30.mjs",
    "test:v30-import:e2e": "node --env-file=.env --import tsx tests/browser-v30-import.mjs",
    "test:agreements:e2e": "node --env-file=.env tests/browser-agreements.mjs",
    "test:territories:e2e": "node --env-file=.env tests/browser-territories.mjs",
    "test:providers:e2e": "node --env-file=.env tests/browser-providers.mjs",
    "test:providers:webhooks": "node --env-file=.env tests/provider-webhooks.mjs",
    "test:usability:e2e": "node --env-file=.env tests/browser-usability.mjs",
    "test:seller-sales:e2e": "node --env-file=.env tests/browser-seller-sales.mjs",
    "test:map-filters:e2e": "node --env-file=.env tests/browser-map-filters.mjs",
    "test:sales-followups:e2e": "node --env-file=.env tests/browser-sales-followups.mjs",
    "test:rotor-files:e2e": "node --env-file=.env tests/browser-rotor-file-import.mjs",
    "test:superhub:e2e": "node --env-file-if-exists=.env tests/browser-superhub.mjs",
    "test:team:e2e": "node --env-file-if-exists=.env tests/browser-team.mjs",
    "test:omega-operations:e2e": "node --env-file-if-exists=.env tests/browser-omega-operations.mjs",
    "test:access-calendar:e2e": "node --env-file-if-exists=.env tests/browser-access-calendar.mjs",
    "test:native-core:e2e": "node --env-file-if-exists=.env tests/browser-native-core.mjs",
    "test:leaderboard:e2e": "node --env-file-if-exists=.env tests/browser-leaderboard.mjs",
    "test:archive-gates:e2e": "node --env-file-if-exists=.env tests/browser-archive-gates.mjs",
    "test:omega-supervisor:e2e": "node --env-file-if-exists=.env tests/browser-omega-supervisor.mjs",
    "test:lead-table:e2e": "node --env-file-if-exists=.env tests/browser-lead-table.mjs",
    "test:omega-workspace:e2e": "node --env-file-if-exists=.env tests/browser-omega-workspace.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "leaflet": "^1.9.4",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^23.0.0",
    "twilio": "^6.2.0",
    "zod": "4.6.6",
    "@googlemaps/js-api-loader": "^2.1.3"
  },
  "devDependencies": {
    "@prisma/internals": "^6.19.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "1.58.2",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "@types/google.maps": "^3.66.6"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
