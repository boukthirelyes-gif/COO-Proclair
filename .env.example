# Values below are placeholders. Enter real values in Vercel Environment Variables.
# Runtime PostgreSQL URL, ideally a provider-managed pooler with TLS.
DATABASE_URL=
# Direct (non-transaction-pooled) connection for migrations during production builds.
DIRECT_DATABASE_URL=
# Private admin password (12 characters minimum; prefer a generated long password).
PROCLAIR_ADMIN_PASSWORD=
# Stable random secret (32 characters minimum). Encrypts OAuth tokens and signs sessions.
PROCLAIR_SESSION_SECRET=
# HTTPS origin without a path or trailing slash, e.g. https://your-project.vercel.app
PROCLAIR_PUBLIC_ORIGIN=
# Random secret (32 characters minimum) used by Vercel Cron Authorization header.
CRON_SECRET=

# Stripe: test only. Configure securely in Vercel; never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Twilio: signed inbound webhooks. All real outbound effects default to off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SEND_ENABLED=false
TWILIO_VOICE_ENABLED=false
TWILIO_FORWARD_TO=

# Browser key: enable Maps JavaScript API; restrict by HTTPS referrers and API.
# This public key is embedded at build time. Rebuild after configuring it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Places and Routes are not enabled by this map integration.
