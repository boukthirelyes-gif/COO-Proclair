# Values below are placeholders. Enter real values in Vercel Environment Variables.
# Runtime PostgreSQL URL, ideally a provider-managed pooler with TLS.
DATABASE_URL=
# Direct (non-transaction-pooled) connection for migrations during production builds.
DIRECT_DATABASE_URL=
# Private admin password (12 characters minimum; prefer a generated long password).
PROCLAIR_ADMIN_PASSWORD=
# Stable random secret (32 characters minimum). Encrypts OAuth tokens and signs sessions.
PROCLAIR_SESSION_SECRET=
# HTTPS origin without a path or trailing slash, e.g. https://your-project.vercel.app
PROCLAIR_PUBLIC_ORIGIN=
# Random secret (32 characters minimum) used by Vercel Cron Authorization header.
CRON_SECRET=

# Stripe: test only. Configure securely in Vercel; never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Twilio: signed inbound webhooks. All real outbound effects default to off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SEND_ENABLED=false
TWILIO_VOICE_ENABLED=false
TWILIO_FORWARD_TO=

# Public browser key, restricted to Maps JavaScript API and CRM HTTPS referrers.
# Configure in Vercel, then rebuild. Missing key retains the existing map.
# Browser-only key: HTTPS referrer restrictions + Maps JavaScript API. Never use a server key.
GOOGLE_MAPS_BROWSER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Required only for Vercel Preview; must identify a separate database.
PROCLAIR_PREVIEW_DATABASE_URL=

# Stripe Enterprise: independent credentials and webhook destinations per mode.
# TEST falls back to legacy STRIPE_SECRET_KEY only if it begins with sk_test_.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Remain disabled until the owner explicitly authorizes LIVE activation.
STRIPE_LIVE_PAYMENTS_ENABLED=false
# Owner's authorization/change reference (at least 12 characters), never a secret key.
STRIPE_LIVE_APPROVAL_REFERENCE=
# TEST webhook: /api/webhooks/stripe?mode=TEST
# LIVE webhook: /api/webhooks/stripe?mode=LIVE

# Communication Center — disabled until explicitly configured and authorized
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
RESEND_DOMAIN_ID=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=
# Resend signed webhook: /api/webhooks/email
# Voice bridge: calls the authorized agent, then the customer; never ports Rotor's number
TWILIO_OUTBOUND_ENABLED=false
TWILIO_AGENT_PHONE=
